# Application
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://pdf-tools.example.com"

# Database
DATABASE_URL="mysql://pdfuser:pdfpassword@localhost:3306/pdf_tools"

# Authentication (Clerk — auth + roles only; NO Clerk Billing / Stripe)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"
# Default role assigned to new Clerk users: ADMIN | TEACHER | STUDENT
DEFAULT_ROLE="TEACHER"

# Subscriptions (handled in our own DB via Prisma; gateway updates status via webhook)
PAYMENT_GATEWAY="snippe"            # snippe | flutterwave | manual (default for POST /api/subscription)
SNIPPE_WEBHOOK_SECRET="change-me"
FLUTTERWAVE_WEBHOOK_SECRET="change-me"
MANUAL_WEBHOOK_SECRET="change-me"   # admin / bank-transfer confirmations
PREMIUM_PLAN_ID=""                  # id of the teacher monthly plan (seed or set manually)
PREMIUM_PLAN_PRICE="9.99"           # price used by ensureDefaultPlan() / npm run db:seed

# MinIO
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="change-me-in-production"
MINIO_SECRET_KEY="change-me-in-production"
MINIO_BUCKET="pdf-tools"

# Redis
REDIS_URL="redis://localhost:6379"

# Gemini AI
GEMINI_API_KEY=""

# Rate Limiting
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="60000"

